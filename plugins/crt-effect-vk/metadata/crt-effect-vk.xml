<?xml version="1.0"?>
<wayfire>
    <plugin name="crt-effect-vk">
        <_short>CRT Effect (Vulkan)</_short>
        <_long>A high-performance CRT shader suite ported to the Vulkan backend.</_long>
        <category>Utility</category>

        <option name="enabled" type="bool">
            <default>true</default>
        </option>
        <option name="duration" type="int">
            <default>1000</default>
        </option>
        <option name="toggle" type="activator">
            <default>&lt;super&gt; &lt;alt&gt; KEY_C</default>
        </option>
        <option name="cycle" type="activator">
            <default>&lt;super&gt; &lt;alt&gt; KEY_N</default>
        </option>

        <option name="scanlines_enable" type="bool">
            <default>true</default>
        </option>
        <option name="distort_enable" type="bool">
            <default>true</default>
        </option>

        <option name="mask_type" type="int">
            <default>1</default>
            <min>0</min>
            <max>2</max>
        </option>
        <option name="beam_sigma" type="double">
            <default>0.5</default>
        </option>
        <option name="scanline_weight" type="double">
            <default>0.3</default>
        </option>
        <option name="border_size" type="double">
            <default>0.05</default>
        </option>
        <option name="brightness" type="double">
            <default>1.2</default>
        </option>

        <option name="conv_x_r" type="double">
            <default>0.001</default>
        </option>
        <option name="conv_x_b" type="double">
            <default>-0.001</default>
        </option>
    </plugin>
</wayfire>
