<?xml version="1.0"?>
<wayfire>
    <plugin name="gapsdecor">
        <_short>Gapsdecor</_short>
        <category>Utility</category>
        <group>
            <_short>Appearance</_short>
            <option name="corner_radius" type="int">
                <_short>Corner Radius</_short>
                <default>8</default>
            </option>
            <option name="active_color" type="color">
                <_short>Active Color</_short>
                <default>0.2 0.2 0.2 1.0</default>
            </option>
            <option name="inactive_color" type="color">
                <_short>Inactive Color</_short>
                <default>0.1 0.1 0.1 1.0</default>
            </option>
            <option name="font" type="string">
                <_short>Title Font</_short>
                <default>sans-serif</default>
            </option>
            <option name="font_color" type="color">
                <_short>Font Color</_short>
                <default>1.0 1.0 1.0 1.0</default>
            </option>
            <option name="title_height" type="int">
                <_short>Title Height</_short>
                <default>24</default>
            </option>
            <option name="border_size" type="int">
                <_short>Border Size</_short>
                <default>4</default>
            </option>
            <option name="gap_size" type="int">
              <_short>Gap Size</_short>
              <default>5</default>
            </option>
        </group>
    </plugin>
</wayfire>
